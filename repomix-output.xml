            <img 
              src={`https://img.youtube.com/vi/${prevClient.videos[0]}/hqdefault.jpg`} 
              alt=""
              className="w-full h-full object-cover pointer-events-none"
            />
            <div className="absolute inset-0 bg-black/70" />
          </div>

          {/* 2. Center Slider Stage (Wrapped in AnimatePresence for smooth Sliding Effects) */}
          <div 
            className="w-[92%] sm:w-[88%] md:w-[82%] shrink-0 aspect-video bg-black rounded-none border-2 border-brand-primary shadow-2xl relative z-20 overflow-hidden"

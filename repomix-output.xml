      {/* Sliding Track Viewport */}
      <div className="relative w-full max-w-full px-2 select-none mb-6 overflow-hidden">
        
        {/* Soft edge gradients on side boundaries */}
        <div className="absolute left-0 top-0 bottom-0 w-8 sm:w-20 bg-gradient-to-r from-brand-bg to-transparent z-20 pointer-events-none" />
        <div className="absolute right-0 top-0 bottom-0 w-8 sm:w-20 bg-gradient-to-l from-brand-bg to-transparent z-20 pointer-events-none" />

        {/* Horizontal track with Framer Motion Swipe listeners */}
